# Baseline two-S3 fixture. These names are derived from pytest-embedded-cli
# profile and peer directory names; host/device do not describe BLE roles.
TEST_SERIAL_PORT_S3_PEER_HOST=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_DEVICE_S3_PEER_DEVICE=/dev/ttyUSB1

# Optional P4+C6 ESP-Hosted parent fixture. Prefer the standard SDIO wiring
# expected by the generic esp32p4 variant; see docs/ESP_HOSTED_SETUP.ja.md.
TEST_SERIAL_PORT_P4_PEER_HOST=/dev/ttyUSB2

# Original-ESP32 pair. That chip runs the NimBLE host EspBle bundles, and it is
# the only target with a Bluetooth Classic radio, so both the bundled-host sweeps
# and every Classic and dual-host suite need it. The values below are the
# reference rig, where the ESP32 pair is on the two USB ports and the two S3
# boards move to /dev/ttyACM0 and /dev/ttyACM1; every port must be distinct on
# your machine.
TEST_SERIAL_PORT_ESP32_PEER_HOST=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_DEVICE_ESP32_PEER_DEVICE=/dev/ttyUSB1

# Wi-Fi credentials used only by the ESP-Hosted Wi-Fi/BLE coexistence test.
TEST_WIFI_SSID=example-test-ssid
TEST_WIFI_PASSWORD=example-test-password

# Optional single-board profile.
TEST_SERIAL_PORT_ESP32S3=/dev/ttyACM0

# Third board (Peripheral B) for tests/manual/multi_connection. Leave it unset
# when that board is absent; the test then skips.
TEST_SERIAL_PORT_PEER_DEVICE2=/dev/ttyACM3

#PYTEST_ADDOPTS="--html=report.html --self-contained-html"
